# Root .env file for docker-compose
# Copy this to .env and fill in your values
# docker-compose reads this file automatically

# ============================================
# REQUIRED: Generate secure secrets
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=your-32-char-base64-secret-for-encryption
JWT_SECRET=your-jwt-signing-secret-min-32-chars

# ============================================
# REQUIRED: OAuth Credentials
# ============================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# LLM Provider API Keys (at least one required)
# ============================================

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Grok (xAI): https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-beta

# OpenRouter (multi-provider gateway): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# NVIDIA NIM: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Ollama (local) - no API key needed
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# ============================================
# OPTIONAL: NextAuth (Frontend)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32

# ============================================
# INFRASTRUCTURE (usually keep defaults)
# ============================================
# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/jd_resume_changer

# Redis
REDIS_URL=redis://redis:6379

# URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# File upload
MAX_UPLOAD_SIZE_MB=10

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60