{
  "manifest_version": 3,
  "name": "JD Resume Changer",
  "version": "1.0.0",
  "description": "Tailor your LaTeX resume to any job description using AI and compile to PDF locally.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["jszip.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
