# Server .env file
# Copy this file to .env and fill in your values

# Database - Use SQLite for local dev if postgres not available
DATABASE_URL=sqlite+aiosqlite:///./jd_resume_changer.db

# Redis - optional for local dev
REDIS_URL=redis://localhost:6379

# App Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
APP_SECRET=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth - Google (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (get from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for CORS, redirects)
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ============================================
# LLM Provider API Keys & Model Names
# ============================================

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Grok (xAI): https://console.x.ai/
GROK_API_KEY=
GROK_MODEL=grok-beta

# OpenRouter (multi-provider gateway): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# NVIDIA NIM: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Ollama (local) - no API key needed
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# File upload
MAX_UPLOAD_SIZE_MB=10

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60