# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jd_resume_changer

# Redis
REDIS_URL=redis://localhost:6379

# App Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
APP_SECRET=your-32-char-base64-secret-for-encryption
JWT_SECRET=your-jwt-signing-secret
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth - Google (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (get from GitHub Developer Settings)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL (for CORS, redirects)
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM Provider defaults (fallback if user doesn't provide keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest

# File upload
MAX_UPLOAD_SIZE_MB=10

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60